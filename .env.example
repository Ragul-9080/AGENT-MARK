# ---------------------------------------------------------------------------
# Agentic Marketing Platform - environment template
# Copy to .env and fill in. Never commit .env.
# ---------------------------------------------------------------------------

# Runtime -------------------------------------------------------------------
APP_ENV=development
LOG_LEVEL=INFO
PUBLIC_BASE_URL=http://localhost:8000
DASHBOARD_ORIGIN=http://localhost:3000

# Database and queue --------------------------------------------------------
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/ama
REDIS_URL=redis://localhost:6379/0

# Auth ----------------------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=replace-me-with-a-long-random-secret
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7
AUTH_RATE_LIMIT_PER_MINUTE=20

# LLM (provider adapter; no provider is called in Milestone 1) ---------------
LLM_PROVIDER=console
LLM_API_KEY=
LLM_MODEL=

# Voice - Vobiz -------------------------------------------------------------
# Vobiz REST API authenticates with two headers: X-Auth-ID and X-Auth-Token.
# Both values are shown in the Vobiz console under Settings -> API.
VOBIZ_AUTH_ID=
VOBIZ_AUTH_TOKEN=
VOBIZ_WEBHOOK_SECRET=
VOBIZ_PHONE_NUMBER=

# Voice - Sarvam ------------------------------------------------------------
SARVAM_API_KEY=
SARVAM_STT_MODEL=saaras:v3
SARVAM_TTS_MODEL=bulbul:v3
SARVAM_DEFAULT_LANGUAGE=hi-IN
SARVAM_DEFAULT_SPEAKER=anushka

# Email ---------------------------------------------------------------------
# console = log only (local development). ses = Amazon SES.
EMAIL_PROVIDER=console
EMAIL_FROM_NAME=
EMAIL_FROM_ADDRESS=
EMAIL_WEBHOOK_SECRET=
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
SES_CONFIGURATION_SET=

# Compliance ----------------------------------------------------------------
# Inclusive local-time window, 24h clock.
DEFAULT_CALLING_WINDOW=09:00-21:00
# Optional DND registry adapter; empty = registry check is recorded as unavailable.
DND_REGISTRY_PROVIDER=

# Limits --------------------------------------------------------------------
CONTACT_IMPORT_MAX_ROWS=5000
CONTACT_IMPORT_MAX_BYTES=5242880
# Run Celery tasks inline instead of on a worker (local experiments only).
CELERY_TASK_ALWAYS_EAGER=false
CORS_ORIGINS=http://localhost:3000

# Dashboard server-side proxy (apps/web) ------------------------------------
# Browser calls the dashboard's own /api/backend route; only the server needs this.
API_INTERNAL_URL=http://localhost:8000
