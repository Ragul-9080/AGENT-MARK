{
  "deployment": {
    "name": "campaigns",
    "stack": "python39",
    "type": "advancedio",
    "env_variables": {
      "APP_ENV": "production",
      "LOG_LEVEL": "INFO",
      "JWT_SECRET": "${JWT_SECRET}",
      "DATABASE_URL": "${DATABASE_URL}",
      "PUBLIC_BASE_URL": "${PUBLIC_BASE_URL}",
      "DASHBOARD_ORIGIN": "${DASHBOARD_ORIGIN}"
    }
  },
  "execution": {
    "main": "main.py"
  }
}
