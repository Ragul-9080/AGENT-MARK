{
  "deployment": {
    "name": "auth",
    "stack": "python39",
    "type": "advancedio",
    "env_variables": {
      "APP_ENV": "production",
      "LOG_LEVEL": "INFO",
      "JWT_SECRET": "${JWT_SECRET}",
      "DATABASE_URL": "${DATABASE_URL}",
      "REDIS_URL": "${REDIS_URL}",
      "AUTH_RATE_LIMIT_PER_MINUTE": "20",
      "ACCESS_TOKEN_MINUTES": "15",
      "REFRESH_TOKEN_DAYS": "7",
      "PUBLIC_BASE_URL": "${PUBLIC_BASE_URL}",
      "DASHBOARD_ORIGIN": "${DASHBOARD_ORIGIN}"
    }
  },
  "execution": {
    "main": "main.py"
  }
}
